# FinanceOS local configuration
# Copy this file to .env.local (Windows: copy .env.local.example .env.local)
# and fill in your Intuit DEVELOPMENT (sandbox) keys.
# .env.local is git-ignored. Never commit or share real credentials.

# --- QuickBooks Online (Intuit Developer, sandbox / development keys only) ---
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Only "sandbox" is supported in this version. Any other value is rejected.
INTUIT_ENVIRONMENT=sandbox

# --- Local AI (Ollama) ---
OLLAMA_MODEL=qwen3:4b
# Must be a local address (127.0.0.1 or localhost). Other hosts are refused.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Optional (leave blank unless you need them) ---
# Seconds to wait for a full AI answer before falling back (default 180).
OLLAMA_TIMEOUT_SECONDS=180
# 64 hexadecimal characters (32 bytes) used to encrypt stored QuickBooks tokens
# and the synced snapshot. If blank, a key is generated into .data/secret.key.
FINANCEOS_ENCRYPTION_KEY=
# Folder for local data (default: the .data folder inside financeos).
FINANCEOS_DATA_DIR=
# Extra host names allowed to reach the app besides localhost (advanced).
FINANCEOS_ALLOWED_HOSTS=
