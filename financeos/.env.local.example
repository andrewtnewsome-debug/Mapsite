# FinanceOS local configuration
# Copy this file to .env.local and fill in your Intuit DEVELOPMENT (sandbox) keys.
# .env.local is git-ignored. Never commit real credentials.

# --- QuickBooks Online (Intuit Developer, sandbox / development keys only) ---
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Only "sandbox" is supported in this version. Any other value is rejected.
INTUIT_ENVIRONMENT=sandbox

# --- Local AI (Ollama) ---
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Optional ---
# 64 hex characters (32 bytes) used to encrypt stored QuickBooks tokens.
# Leave blank and FinanceOS generates a key file in .data/ on first use.
FINANCEOS_ENCRYPTION_KEY=
# Seconds to wait for a full Ollama answer before falling back (default 180).
OLLAMA_TIMEOUT_SECONDS=180
